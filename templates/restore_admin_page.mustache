{{!
  @template local_coursetransfer/restore_admin_page

  Admin remote-restore assistant (SPA-lite): landing + 4-step wizard + done,
  toggled by the local_coursetransfer/restore_wizard AMD module.

  Example context (json):
  {
    "headertitle": "Restaurar cursos o categoría remota",
    "headerdesc": "Trae cursos o una categoría desde otra plataforma Moodle.",
    "back": "#", "summaryurl": "#", "logurl": "#",
    "destcategories": [{"value": 0, "label": "Categoría por defecto"}],
    "recent": [], "hasrecent": false
  }
}}
<div class="local-coursetransfer ct-wide" data-region="restore_admin"
        data-logurl="{{ logurl }}">

    <div class="ct-hero">
        {{> local_coursetransfer/components/page_header }}
        <a href="{{ logurl }}" class="ct-btn ct-btn--secondary ct-btn--sm">
            <i class="fa fa-list-alt" aria-hidden="true"></i>
            {{#str}} rw_done_gotolog, local_coursetransfer {{/str}}
        </a>
    </div>

    {{! ===================== LANDING ===================== }}
    <div data-region="landing">
        <div class="ct-startcard">
            <span class="ct-startcard-icon"><i class="fa fa-download" aria-hidden="true"></i></span>
            <div class="ct-startcard-body">
                <h2 class="ct-startcard-title">{{#str}} rw_start, local_coursetransfer {{/str}}</h2>
                <p class="ct-startcard-desc">{{#str}} rw_start_desc, local_coursetransfer {{/str}}</p>
            </div>
            <button type="button" class="ct-btn ct-btn--primary" data-action="start">
                <i class="fa fa-plus" aria-hidden="true"></i>
                {{#str}} rw_start, local_coursetransfer {{/str}}
            </button>
        </div>

        <div class="ct-recent">
            <div class="ct-recent-head">
                <h2>{{#str}} rw_recent, local_coursetransfer {{/str}}</h2>
                <span class="ct-recent-spacer" style="flex:1"></span>
                <a href="{{ logurl }}">{{#str}} rw_done_gotolog, local_coursetransfer {{/str}}</a>
            </div>
            {{#hasrecent}}
            <div class="ct-recent-list">
                {{#recent}}
                <div class="ct-recent-card">
                    <div class="ct-recent-row">
                        <span class="ct-badge {{ badgeclass }}">{{ statuslabel }}</span>
                        <span class="ct-recent-summary">{{ summary }}</span>
                        <span class="ct-text-muted">{{ date }}</span>
                    </div>
                    <div class="ct-recent-row" style="margin-top:8px">
                        <span class="ct-text-muted">{{#str}} rw_review_from, local_coursetransfer {{/str}} <strong>{{ site }}</strong></span>
                        {{#hasdest}}<span class="ct-text-muted">· {{ dest }}</span>{{/hasdest}}
                        <span class="ct-recent-spacer" style="flex:1"></span>
                        <a href="{{ logurl }}">{{#str}} exec_detail, local_coursetransfer {{/str}}</a>
                    </div>
                    {{#iserror}}
                    <div class="ct-alert ct-alert--danger ct-mt">
                        <i class="fa fa-exclamation-triangle ct-alert-icon" aria-hidden="true"></i>
                        <p><strong>{{ errcause }}</strong><br>{{ erraction }}</p>
                    </div>
                    {{/iserror}}
                </div>
                {{/recent}}
            </div>
            {{/hasrecent}}
            {{^hasrecent}}
            <div class="ct-recent-card ct-text-muted">{{#str}} rw_empty_recent, local_coursetransfer {{/str}}</div>
            {{/hasrecent}}
        </div>
    </div>

    {{! ===================== WIZARD ===================== }}
    <div class="ct-card ct-wizard" data-region="wizard" hidden>

        <div class="ct-steps" data-region="steps">
            <div class="ct-step" data-step-index="0" data-state="current">
                <div class="ct-step-cell">
                    <span class="ct-step-marker">1</span>
                    <span class="ct-step-label">{{#str}} rw_step_site, local_coursetransfer {{/str}}</span>
                </div>
                <span class="ct-step-connector"></span>
            </div>
            <div class="ct-step" data-step-index="1" data-state="pending">
                <div class="ct-step-cell">
                    <span class="ct-step-marker">2</span>
                    <span class="ct-step-label">{{#str}} rw_step_select, local_coursetransfer {{/str}}</span>
                </div>
                <span class="ct-step-connector"></span>
            </div>
            <div class="ct-step" data-step-index="2" data-state="pending">
                <div class="ct-step-cell">
                    <span class="ct-step-marker">3</span>
                    <span class="ct-step-label">{{#str}} rw_step_dest, local_coursetransfer {{/str}}</span>
                </div>
                <span class="ct-step-connector"></span>
            </div>
            <div class="ct-step" data-step-index="3" data-state="pending">
                <div class="ct-step-cell">
                    <span class="ct-step-marker">4</span>
                    <span class="ct-step-label">{{#str}} rw_step_confirm, local_coursetransfer {{/str}}</span>
                </div>
            </div>
        </div>

        <div class="ct-wizard-body">

            {{! ---- STEP 0 · Site + type ---- }}
            <div data-step="0">
                <h2 class="ct-section-title">{{#str}} rw_q_site, local_coursetransfer {{/str}}</h2>
                <div class="ct-rolecards ct-mt" data-region="sites">
                    <div class="ct-selempty" data-region="sites-loading">{{#str}} rw_loading, local_coursetransfer {{/str}}</div>
                </div>

                <h2 class="ct-section-title ct-mt">{{#str}} rw_q_type, local_coursetransfer {{/str}}</h2>
                <div class="ct-rolecards ct-mt" style="grid-template-columns:1fr 1fr" data-region="types">
                    <button type="button" class="ct-rolecard ct-rolecard--target" data-action="toggle-type"
                            data-type="course" aria-pressed="false">
                        <span class="ct-rolecard-check"><i class="fa fa-check" aria-hidden="true"></i></span>
                        <span>
                            <span class="ct-rolecard-title">{{#str}} rw_kind_course, local_coursetransfer {{/str}}</span>
                            <span class="ct-rolecard-desc">{{#str}} rw_kind_course_desc, local_coursetransfer {{/str}}</span>
                        </span>
                    </button>
                    <button type="button" class="ct-rolecard ct-rolecard--target" data-action="toggle-type"
                            data-type="category" aria-pressed="false">
                        <span class="ct-rolecard-check"><i class="fa fa-check" aria-hidden="true"></i></span>
                        <span>
                            <span class="ct-rolecard-title">{{#str}} rw_kind_category, local_coursetransfer {{/str}}</span>
                            <span class="ct-rolecard-desc">{{#str}} rw_kind_category_desc, local_coursetransfer {{/str}}</span>
                        </span>
                    </button>
                </div>
            </div>

            {{! ---- STEP 1 · Selection ---- }}
            <div data-step="1" hidden>
                <div class="ct-search ct-mb">
                    <i class="fa fa-search" aria-hidden="true"></i>
                    <input type="text" data-action="search"
                            placeholder="{{#str}} rw_search_ph, local_coursetransfer {{/str}}">
                </div>

                <div class="ct-selcounter" data-region="selcounter">
                    <span class="ct-selcounter-num" data-region="selcount">0</span>
                    <span class="ct-selcounter-label" data-region="sellabel">{{#str}} rw_selected, local_coursetransfer, 0 {{/str}}</span>
                    <button type="button" class="ct-selcounter-clear" data-action="clear" hidden>{{#str}} rw_clear, local_coursetransfer {{/str}}</button>
                </div>

                <div class="ct-seltable">
                    <div class="ct-seltable-head">
                        <button type="button" class="ct-checkbox" data-action="toggle-page" aria-label="{{#str}} rw_selectall, local_coursetransfer {{/str}}">
                            <i class="fa fa-check" aria-hidden="true"></i>
                        </button>
                        <span class="ct-col-name">{{#str}} rw_step_select, local_coursetransfer {{/str}}</span>
                        <span class="ct-col-meta"></span>
                    </div>
                    <div data-region="rows">
                        <div class="ct-selempty" data-region="rows-loading">{{#str}} rw_loading, local_coursetransfer {{/str}}</div>
                    </div>
                </div>

                <div class="ct-selpager" data-region="pager" hidden>
                    <span class="ct-selpager-info" data-region="pageinfo"></span>
                    <button type="button" class="ct-btn ct-btn--outline ct-btn--sm" data-action="prev">
                        <i class="fa fa-chevron-left" aria-hidden="true"></i>{{#str}} rw_back, local_coursetransfer {{/str}}
                    </button>
                    <button type="button" class="ct-btn ct-btn--outline ct-btn--sm" data-action="next-page">
                        {{#str}} rw_next, local_coursetransfer {{/str}}<i class="fa fa-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="ct-alert ct-alert--info ct-mt" data-region="catnote" hidden>
                    <i class="fa fa-info-circle ct-alert-icon" aria-hidden="true"></i>
                    <p>{{#str}} rw_catnote, local_coursetransfer {{/str}}</p>
                </div>
            </div>

            {{! ---- STEP 2 · Destination + options ---- }}
            <div data-step="2" hidden>
                <div class="ct-field">
                    <label class="ct-field-label" for="ct-destcat">{{#str}} rw_destcat, local_coursetransfer {{/str}}</label>
                    <select id="ct-destcat" class="ct-input" data-action="destcat">
                        {{#destcategories}}
                        <option value="{{ value }}">{{ label }}</option>
                        {{/destcategories}}
                    </select>
                </div>

                <div class="ct-field-label ct-mt">{{#str}} rw_mode_heading, local_coursetransfer {{/str}}</div>
                <div class="ct-mt" style="display:grid;gap:12px" data-region="modes">
                    <div class="ct-modeopt" data-mode="merge" aria-pressed="true">
                        <button type="button" class="ct-modeopt-btn" data-action="toggle-mode" data-mode="merge" aria-pressed="true">
                            <span class="ct-radio"></span>
                            <span>
                                <span class="ct-modeopt-title">{{#str}} rw_mode_merge, local_coursetransfer {{/str}}
                                    <span class="ct-tag-rec">{{#str}} rw_recommended, local_coursetransfer {{/str}}</span>
                                </span>
                                <span class="ct-modeopt-desc">{{#str}} rw_mode_merge_desc, local_coursetransfer {{/str}}</span>
                            </span>
                        </button>
                    </div>
                    <div class="ct-modeopt ct-modeopt--danger" data-mode="replace" aria-pressed="false">
                        <button type="button" class="ct-modeopt-btn" data-action="toggle-mode" data-mode="replace" aria-pressed="false">
                            <span class="ct-radio"></span>
                            <span>
                                <span class="ct-modeopt-title">{{#str}} rw_mode_replace, local_coursetransfer {{/str}}
                                    <span class="ct-tag-danger">{{#str}} rw_destructive, local_coursetransfer {{/str}}</span>
                                </span>
                                <span class="ct-modeopt-desc">{{#str}} rw_mode_replace_desc, local_coursetransfer {{/str}}</span>
                            </span>
                        </button>
                        <div class="ct-modeopt-confirm" data-region="confirm" hidden>
                            <button type="button" class="ct-modeopt-confirm-btn" data-action="toggle-confirm" aria-checked="false">
                                <span class="ct-modeopt-confirm-box"><i class="fa fa-check" aria-hidden="true"></i></span>
                                <span>{{#str}} rw_mode_confirm, local_coursetransfer {{/str}}</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="ct-switchrow">
                    <div class="ct-switchrow-body">
                        <span class="ct-rolecard-title">{{#str}} rw_users, local_coursetransfer {{/str}}</span>
                        <span class="ct-rolecard-desc">{{#str}} rw_users_desc, local_coursetransfer {{/str}}</span>
                    </div>
                    <button type="button" class="ct-switch" data-action="toggle-users" role="switch" aria-checked="false"></button>
                </div>
            </div>

            {{! ---- STEP 3 · Review ---- }}
            <div data-step="3" hidden>
                <div class="ct-review" data-region="review"></div>
                <div class="ct-alert ct-alert--danger ct-mt" data-region="review-danger" hidden>
                    <i class="fa fa-exclamation-triangle ct-alert-icon" aria-hidden="true"></i>
                    <p>{{#str}} rw_review_danger, local_coursetransfer {{/str}}</p>
                </div>
                <div class="ct-alert ct-alert--neutral ct-mt">
                    <i class="fa fa-clock-o ct-alert-icon" aria-hidden="true"></i>
                    <p>{{#str}} rw_review_async, local_coursetransfer {{/str}}</p>
                </div>
            </div>

        </div>

        <div class="ct-wizard-footer">
            <button type="button" class="ct-btn ct-btn--ghost" data-action="cancel">{{#str}} rw_cancel, local_coursetransfer {{/str}}</button>
            <button type="button" class="ct-btn ct-btn--outline" data-action="back">
                <i class="fa fa-chevron-left" aria-hidden="true"></i>{{#str}} rw_back, local_coursetransfer {{/str}}
            </button>
            <span class="ct-wizard-stepnum" data-region="stepinfo">{{#str}} rw_step_of, local_coursetransfer, {"n": 1, "total": 4} {{/str}}</span>
            <button type="button" class="ct-btn ct-btn--primary" data-action="primary" data-region="primary">
                {{#str}} rw_next, local_coursetransfer {{/str}}<i class="fa fa-chevron-right" aria-hidden="true"></i>
            </button>
        </div>

    </div>

    {{! ===================== DONE ===================== }}
    <div class="ct-card" data-region="done" hidden>
        <div class="ct-done">
            <div class="ct-done-icon"><i class="fa fa-clock-o" aria-hidden="true"></i></div>
            <h2 class="ct-section-title">{{#str}} rw_done_title, local_coursetransfer {{/str}}</h2>
            <p class="ct-text-muted" data-region="done-desc">{{#str}} rw_done_desc, local_coursetransfer {{/str}}</p>
            <div class="ct-done-actions">
                <a href="{{ logurl }}" class="ct-btn ct-btn--primary" data-region="done-log">
                    <i class="fa fa-list-alt" aria-hidden="true"></i>{{#str}} rw_done_gotolog, local_coursetransfer {{/str}}
                </a>
                <button type="button" class="ct-btn ct-btn--outline" data-action="go-landing">{{#str}} rw_done_back, local_coursetransfer {{/str}}</button>
            </div>
        </div>
    </div>

</div>

{{#js}}
require(['local_coursetransfer/restore_wizard'], function(W) {
    W.init('[data-region="restore_admin"]');
});
{{/js}}
